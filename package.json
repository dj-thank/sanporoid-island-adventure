{
  "name": "openclos-island-trip-board",
  "version": "0.2.5",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "pnpm run build && node --experimental-loader ./tests/cloudflare-loader.mjs --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern native-dist --ignore-pattern android --ignore-pattern ios --ignore-pattern .next --ignore-pattern public/cesiumStatic",
    "native:build": "vite build --config vite.native.config.ts",
    "native:sync": "pnpm native:build && cap sync",
    "android:apk": "pnpm native:build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:apk:ci": "pnpm native:build && cap sync android && cd android && ./gradlew assembleDebug",
    "ios:sync": "pnpm native:build && cap sync ios",
    "pages:build": "vite build --config vite.native.config.ts --mode pages && node scripts/prepare-github-pages.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "cesium": "^1.144.0",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.6.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
